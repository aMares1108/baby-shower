{
    "routes": [
        {
            "route": "/admin*",
            "allowedRoles": ["colaborador"]
        },
        {
            "route": "/api/listRecords",
            "allowedRoles": ["colaborador"]
        },
        {
            "route": "/api/addRecord",
            "allowedRoles": ["anonymous"]
        },
        {
            "route": "/api/*",
            "allowedRoles": ["anonymous"]
        }
    ],
    "responseOverrides": {
        "401": {
            "statusCode": 302,
            "redirect": "/.auth/login/aad?post_login_redirect_uri=/admin"
        }
    },
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": ["/api/*"]
    }
}